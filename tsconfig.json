{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2022", "DOM"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "outDir": "dist",
    "rootDir": ".",

    "baseUrl": ".",

    "paths": {
      "@pages/*": ["apps/automation/pages/*"],
      "@fixtures/*": ["apps/automation/fixtures/*"],
      "@utils/*": ["apps/automation/utils/*"],
      "@data/*": ["apps/automation/data/*"]
    },

    "types": ["node", "@playwright/test"]
  },

  "include": [
    "apps/automation/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}